# Turns act-copy.tsv into act-copy-table.h. Run: cmake -DROWS=... -DOUT=... -P gen-act-copy.cmake
function(act_ident out text)
    string(TOUPPER "${text}" v)
    string(REPLACE "-" "_" v "${v}")
    set(${out} "${v}" PARENT_SCOPE)
endfunction()

file(STRINGS "${ROWS}" lines)
set(rows "")
set(first 1)
foreach(line IN LISTS lines)
    if (line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if (first)
        set(first 0)
        continue()
    endif()
    string(REPLACE ";" "," line "${line}")
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if (NOT n EQUAL 9)
        message(FATAL_ERROR "act-copy.tsv: expected 9 cells, got ${n}: ${line}")
    endif()
    list(GET f 0 family)
    list(GET f 1 route)
    list(GET f 2 pci)
    list(GET f 3 copy)
    list(GET f 4 applies)
    list(GET f 5 rereads)
    list(GET f 6 bytes)
    list(GET f 7 reason)
    list(GET f 8 test)
    act_ident(fam "${family}")
    act_ident(rt "${route}")
    if (NOT pci MATCHES "^0x[0-9a-f]+:0x[0-9a-f]+$")
        message(FATAL_ERROR "act-copy.tsv: pci must be 0xVVVV:0xDDDD, got '${pci}'")
    endif()
    string(REPLACE ":" ";" ids "${pci}")
    list(GET ids 0 vendor)
    list(GET ids 1 device)
    if (copy STREQUAL "bf16")
        set(ct "GGML_TYPE_BF16")
    elseif (copy STREQUAL "f16")
        set(ct "GGML_TYPE_F16")
    else()
        message(FATAL_ERROR "act-copy.tsv: copy must be bf16 or f16, got '${copy}'")
    endif()
    if (applies STREQUAL "yes")
        set(on 1)
    elseif (applies STREQUAL "no")
        set(on 0)
    else()
        message(FATAL_ERROR "act-copy.tsv: applies must be yes or no, got '${applies}'")
    endif()
    if (NOT rereads MATCHES "^[0-9]+$" OR NOT bytes MATCHES "^[0-9]+$")
        message(FATAL_ERROR "act-copy.tsv: min_rereads and max_bytes must be numbers: ${line}")
    endif()
    # two reads and a write per element are paid once, one read is saved per re-read: below 4 a copy cannot pay
    if (rereads LESS 4)
        message(FATAL_ERROR "act-copy.tsv: min_rereads below 4 never pays for the conversion: ${line}")
    endif()
    string(APPEND rows "    { GGML_METAL_LANE_FAMILY_${fam}, GGML_METAL_LANE_ROUTE_${rt}, ${vendor}, ${device}, ${ct}, ${on}, ${rereads}, ${bytes}ull, \"${reason}\", \"${test}\" },\n")
endforeach()

set(text "// generated from act-copy/act-copy.tsv by act-copy/gen-act-copy.cmake; do not edit\n#pragma once\n\nstatic const struct ggml_metal_act_copy_row ggml_metal_act_copy_rows[] = {\n${rows}};\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
