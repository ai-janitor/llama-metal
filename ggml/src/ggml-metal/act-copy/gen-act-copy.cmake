# Turns section [copies] of data/arithmetic.tsv into act-copy-table.h.
# Run: cmake -DTABLE=.../data/arithmetic.tsv -DOUT=... -P gen-act-copy.cmake
# The policies of CMake 3.14 (the project's minimum), so that a quoted word in if() is a string under CMake 3.x too.
cmake_policy(VERSION 3.14)
include("${CMAKE_CURRENT_LIST_DIR}/../data/tsv-read.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../lanes/arithmetic-sections.cmake")
function(act_ident out text)
    string(TOUPPER "${text}" v)
    string(REPLACE "-" "_" v "${v}")
    set(${out} "${v}" PARENT_SCOPE)
endfunction()

tsv_section("${TABLE}" copies "${arithmetic_sections}" lines)
set(rows "")
set(seen "")
set(first 1)
foreach(line IN LISTS lines)
    if (first)
        set(first 0)
        tsv_header("${line}" "${arithmetic_copies_header}" "arithmetic.tsv [copies]")
        continue()
    endif()
    tsv_text("${line}" shown)
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if (NOT n EQUAL 9)
        message(FATAL_ERROR "arithmetic.tsv [copies]: expected 9 cells, got ${n}: ${shown}")
    endif()
    list(GET f 0 card_cell)
    list(GET f 1 family)
    list(GET f 2 route)
    list(GET f 3 copy)
    list(GET f 4 applies)
    list(GET f 5 rereads)
    list(GET f 6 bytes)
    list(GET f 7 reason_cell)
    list(GET f 8 test_cell)
    tsv_card("${card_cell}" "arithmetic.tsv [copies]" card)
    if (family STREQUAL "matmul")
        set(routes mv-scalar mv-grouped mm-tiled mm-matrix)
    elseif (family STREQUAL "flash-attn")
        set(routes fa-scalar fa-vec fa-matrix fa-intel-tiled)
    else()
        message(FATAL_ERROR "arithmetic.tsv [copies]: family must be matmul or flash-attn, got '${family}'")
    endif()
    list(FIND routes "${route}" at)
    if (at EQUAL -1)
        message(FATAL_ERROR "arithmetic.tsv [copies]: '${route}' is not a route of ${family}: ${shown}")
    endif()
    act_ident(fam "${family}")
    act_ident(rt "${route}")
    if (copy STREQUAL "bf16")
        set(ct "GGML_TYPE_BF16")
    elseif (copy STREQUAL "f16")
        set(ct "GGML_TYPE_F16")
    else()
        message(FATAL_ERROR "arithmetic.tsv [copies]: copy must be bf16 or f16, got '${copy}'")
    endif()
    list(FIND seen "${card_cell}\t${family}\t${route}\t${copy}" at)
    if (NOT at EQUAL -1)
        message(FATAL_ERROR "arithmetic.tsv [copies]: two rows for ${card} ${family} ${route} ${copy}")
    endif()
    list(APPEND seen "${card_cell}\t${family}\t${route}\t${copy}")
    if (applies STREQUAL "yes")
        set(on 1)
    elseif (applies STREQUAL "no")
        set(on 0)
    else()
        message(FATAL_ERROR "arithmetic.tsv [copies]: applies must be yes or no, got '${applies}'")
    endif()
    # min_rereads is an int of the row, max_bytes a uint64_t: whole numbers without a leading zero, within those types
    if (NOT rereads MATCHES "^[1-9][0-9]*$" OR NOT bytes MATCHES "^(0|[1-9][0-9]*)$")
        message(FATAL_ERROR "arithmetic.tsv [copies]: min_rereads and max_bytes must be whole numbers without a leading zero: ${shown}")
    endif()
    string(LENGTH "${rereads}" rereads_len)
    string(LENGTH "${bytes}" bytes_len)
    if (rereads_len GREATER 10 OR (rereads_len EQUAL 10 AND rereads STRGREATER "2147483647"))
        message(FATAL_ERROR "arithmetic.tsv [copies]: min_rereads is at most 2147483647: ${shown}")
    endif()
    if (bytes_len GREATER 20 OR (bytes_len EQUAL 20 AND bytes STRGREATER "18446744073709551615"))
        message(FATAL_ERROR "arithmetic.tsv [copies]: max_bytes is at most 18446744073709551615: ${shown}")
    endif()
    # two reads and a write per element are paid once, one read is saved per re-read: below 4 a copy cannot pay
    if (rereads_len EQUAL 1 AND rereads LESS 4)
        message(FATAL_ERROR "arithmetic.tsv [copies]: min_rereads below 4 never pays for the conversion: ${shown}")
    endif()
    tsv_cstring("${reason_cell}" "arithmetic.tsv [copies]" reason)
    tsv_cstring("${test_cell}" "arithmetic.tsv [copies]" test)
    string(APPEND rows "    { GGML_METAL_LANE_FAMILY_${fam}, GGML_METAL_LANE_ROUTE_${rt}, \"${card}\", ${ct}, ${on}, ${rereads}, ${bytes}ull, \"${reason}\", \"${test}\" },\n")
endforeach()
if (first)
    message(FATAL_ERROR "arithmetic.tsv [copies]: the section has no header row")
endif()

set(text "// generated from data/arithmetic.tsv [copies] by act-copy/gen-act-copy.cmake; do not edit\n#pragma once\n\n// { family, route, the card's Metal device name, copy type, applies, min_rereads, max_bytes, reason, test }\nstatic const struct ggml_metal_act_copy_row ggml_metal_act_copy_rows[] = {\n${rows}};\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
