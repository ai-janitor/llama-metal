# Turns lanes.tsv and capability.tsv into lanes-table.h.
# Run: cmake -DLANES=... -DCAPS=... -DOUT=... -P gen-tables.cmake
function(lanes_ident out text)
    string(TOUPPER "${text}" v)
    string(REPLACE "-" "_" v "${v}")
    set(${out} "${v}" PARENT_SCOPE)
endfunction()
function(lanes_tri out text)
    if (text STREQUAL "yes")
        set(${out} 1 PARENT_SCOPE)
    elseif (text STREQUAL "no")
        set(${out} 0 PARENT_SCOPE)
    elseif (text STREQUAL "unknown")
        set(${out} -1 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "lanes: expected yes, no or unknown, got '${text}'")
    endif()
endfunction()
function(lanes_type out text)
    if (text STREQUAL "any")
        set(${out} "GGML_TYPE_COUNT" PARENT_SCOPE)
    else()
        lanes_ident(v "${text}")
        set(${out} "GGML_TYPE_${v}" PARENT_SCOPE)
    endif()
endfunction()

# How a lane operand holds a tensor type; refuses a holds cell that says otherwise.
function(lanes_holds out operand act holds where)
    if (act STREQUAL "any")
        if (operand STREQUAL "f32")
            set(want "wider")
        else()
            set(want "narrower")
        endif()
    elseif (operand STREQUAL act)
        set(want "native")
        if (holds STREQUAL "exact-other")
            set(want "exact-other")
        endif()
    elseif (operand STREQUAL "f32" AND (act STREQUAL "f16" OR act STREQUAL "bf16"))
        set(want "wider")
    else()
        set(want "narrower")
    endif()
    if (NOT holds STREQUAL want)
        message(FATAL_ERROR "${where}: holds is '${holds}', but ${operand} holds ${act} as '${want}'")
    endif()
    lanes_ident(v "${holds}")
    set(${out} "GGML_METAL_LANE_HOLDS_${v}" PARENT_SCOPE)
endfunction()

# capability keys, in order of first use
set(keys "")
file(STRINGS "${CAPS}" cap_lines)
file(STRINGS "${LANES}" lane_lines)
set(cap_rows "")
set(first 1)
foreach(line IN LISTS cap_lines)
    if (line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if (first)
        set(first 0)
        continue()
    endif()
    string(REPLACE ";" "," line "${line}")
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if (NOT n EQUAL 7)
        message(FATAL_ERROR "capability.tsv: expected 7 cells, got ${n}: ${line}")
    endif()
    list(GET f 0 pci)
    list(GET f 1 key)
    list(GET f 2 hw)
    list(GET f 3 re)
    list(GET f 4 ok)
    if (NOT pci MATCHES "^0x[0-9a-f]+:0x[0-9a-f]+$")
        message(FATAL_ERROR "capability.tsv: bad pci '${pci}'")
    endif()
    string(REPLACE ":" ";" p "${pci}")
    list(GET p 0 ven)
    list(GET p 1 dev)
    list(FIND keys "${key}" at)
    if (at EQUAL -1)
        list(APPEND keys "${key}")
    endif()
    lanes_ident(kid "${key}")
    lanes_tri(hwv "${hw}")
    lanes_tri(rev "${re}")
    lanes_tri(okv "${ok}")
    string(APPEND cap_rows "    { ${ven}, ${dev}, GGML_METAL_LANE_CAP_${kid}, ${hwv}, ${rev}, ${okv} },\n")
endforeach()

set(lane_rows "")
set(first 1)
foreach(line IN LISTS lane_lines)
    if (line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if (first)
        set(first 0)
        continue()
    endif()
    string(REPLACE ";" "," line "${line}")
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if (NOT n EQUAL 18)
        message(FATAL_ERROR "lanes.tsv: expected 18 cells, got ${n}: ${line}")
    endif()
    list(GET f 0 lane)
    list(GET f 1 source)
    list(GET f 2 file)
    list(GET f 3 family)
    list(GET f 4 route)
    list(GET f 5 weight)
    list(GET f 6 act)
    list(GET f 7 operand)
    list(GET f 8 holds)
    list(GET f 9 entry)
    list(GET f 10 key)
    list(GET f 11 cls)
    list(GET f 12 origin)
    list(GET f 13 def)
    list(GET f 14 seam)
    list(GET f 15 id)
    list(GET f 16 reason)
    list(GET f 17 test)
    if (operand STREQUAL "any")
        message(FATAL_ERROR "lanes.tsv: a lane has one operand format: ${line}")
    endif()
    lanes_type(ot "${operand}")
    lanes_holds(hd "${operand}" "${act}" "${holds}" "lanes.tsv ${lane} ${route}")
    lanes_ident(fam "${family}")
    lanes_ident(rt "${route}")
    lanes_ident(cl "${cls}")
    lanes_ident(og "${origin}")
    lanes_ident(src "${source}")
    lanes_type(wt "${weight}")
    lanes_type(at "${act}")
    if (key STREQUAL "-")
        set(kid "GGML_METAL_LANE_CAP_NONE")
    else()
        list(FIND keys "${key}" found)
        if (found EQUAL -1)
            list(APPEND keys "${key}")
        endif()
        lanes_ident(k "${key}")
        set(kid "GGML_METAL_LANE_CAP_${k}")
    endif()
    if (def STREQUAL "on")
        set(on 1)
    elseif (def STREQUAL "off")
        set(on 0)
    else()
        message(FATAL_ERROR "lanes.tsv: default must be on or off, got '${def}'")
    endif()
    if (entry STREQUAL "-")
        set(entry "")
    endif()
    string(APPEND lane_rows "    { \"${lane}\", GGML_METAL_LANE_SOURCE_${src}, \"${file}\", GGML_METAL_LANE_FAMILY_${fam}, GGML_METAL_LANE_ROUTE_${rt}, ${wt}, ${at}, ${ot}, ${hd}, \"${entry}\", ${kid}, GGML_METAL_LANE_CLASS_${cl}, GGML_METAL_LANE_ORIGIN_${og}, ${on}, ${seam}, ${id}, \"${reason}\", \"${test}\" },\n")
endforeach()

set(cap_enum "    GGML_METAL_LANE_CAP_NONE = -1,\n")
set(i 0)
foreach(key IN LISTS keys)
    lanes_ident(k "${key}")
    string(APPEND cap_enum "    GGML_METAL_LANE_CAP_${k} = ${i},\n")
    math(EXPR i "${i} + 1")
endforeach()

set(text "// generated from lanes/lanes.tsv and lanes/capability.tsv by lanes/gen-tables.cmake; do not edit\n#pragma once\n\nenum ggml_metal_lane_cap {\n${cap_enum}};\n\nstatic const struct ggml_metal_lane_row ggml_metal_lane_rows[] = {\n${lane_rows}};\n\nstatic const struct ggml_metal_lane_cap_row ggml_metal_lane_cap_rows[] = {\n${cap_rows}};\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
