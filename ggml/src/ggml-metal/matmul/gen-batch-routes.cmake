# Turns batch-routes.tsv into batch-routes-table.h. Run: cmake -DROUTES=... -DFORMATS=... -DOUT=... -P gen-batch-routes.cmake
# formats.tsv says which weight types have a small-batch and a tiled kernel.
file(STRINGS "${FORMATS}" flines)
set(first 1)
set(known "")
foreach(line IN LISTS flines)
    if (line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if (first)
        set(first 0)
        continue()
    endif()
    string(REPLACE "\t" ";" f "${line}")
    list(GET f 0 type)
    list(GET f 9 ext)
    list(GET f 10 tiled)
    list(APPEND known "${type}")
    set(ext_of_${type} "${ext}")
    set(tiled_of_${type} "${tiled}")
endforeach()

file(STRINGS "${ROUTES}" lines)
set(rows "")
set(seen "")
set(first 1)
foreach(line IN LISTS lines)
    if (line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if (first)
        set(first 0)
        continue()
    endif()
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if (NOT n EQUAL 6)
        message(FATAL_ERROR "batch-routes.tsv: expected 6 cells, got ${n}: ${line}")
    endif()
    list(GET f 0 pci)
    list(GET f 1 weight)
    list(GET f 2 ext_from)
    list(GET f 3 tiled_from)
    list(GET f 4 source)
    if (NOT pci MATCHES "^0x([0-9a-fA-F]+):0x([0-9a-fA-F]+)$")
        message(FATAL_ERROR "batch-routes.tsv: pci must be 0xVVVV:0xDDDD: ${line}")
    endif()
    set(ven "0x${CMAKE_MATCH_1}")
    set(dev "0x${CMAKE_MATCH_2}")
    list(FIND known "${weight}" at)
    if (at EQUAL -1)
        message(FATAL_ERROR "batch-routes.tsv: weight '${weight}' has no row in formats.tsv")
    endif()
    list(FIND seen "${pci} ${weight}" at)
    if (NOT at EQUAL -1)
        message(FATAL_ERROR "batch-routes.tsv: two rows for ${pci} ${weight}")
    endif()
    list(APPEND seen "${pci} ${weight}")
    if (source STREQUAL "" OR source STREQUAL "-")
        message(FATAL_ERROR "batch-routes.tsv: ${pci} ${weight} names no source")
    endif()
    if (ext_from STREQUAL "-")
        set(ef 0)
    elseif (ext_from MATCHES "^[2-9]$")
        if (ext_of_${weight} STREQUAL "no")
            message(FATAL_ERROR "batch-routes.tsv: ${weight} has no small-batch kernel, ext_from must be -")
        endif()
        set(ef ${ext_from})
    else()
        message(FATAL_ERROR "batch-routes.tsv: ext_from of ${pci} ${weight} must be 2..9 or -")
    endif()
    if (tiled_from STREQUAL "-")
        set(tf 0)
    elseif (tiled_from MATCHES "^[0-9]+$" AND tiled_from GREATER 1)
        if (NOT tiled_of_${weight} STREQUAL "yes")
            message(FATAL_ERROR "batch-routes.tsv: ${weight} has no tiled kernel, tiled_from must be -")
        endif()
        if (ef GREATER 0 AND NOT tiled_from GREATER ef)
            message(FATAL_ERROR "batch-routes.tsv: tiled_from of ${pci} ${weight} must be above its ext_from")
        endif()
        set(tf ${tiled_from})
    else()
        message(FATAL_ERROR "batch-routes.tsv: tiled_from of ${pci} ${weight} must be a column count from 2 or -")
    endif()
    string(TOUPPER "${weight}" id)
    string(APPEND rows "    { ${ven}, ${dev}, GGML_TYPE_${id}, ${ef}, ${tf} },\n")
endforeach()

set(text "// generated from matmul/batch-routes.tsv by matmul/gen-batch-routes.cmake; do not edit\n#pragma once\n\n// { pci_vendor, pci_device, weight type, ext_from, tiled_from }; 0 = the cell is -; the last row is the end mark\nstatic const struct mv_batch_row mv_batch_rows[] = {\n${rows}    { 0, 0, GGML_TYPE_COUNT, 0, 0 },\n};\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
