# Turns formats.tsv into mv-formats-table.h. Run: cmake -DFORMATS=... -DOUT=... -P gen-formats.cmake
function(fmt_flag out name text)
    if (text STREQUAL "yes")
        set(${out} 1 PARENT_SCOPE)
    elseif (text STREQUAL "no")
        set(${out} 0 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "formats.tsv: ${name} must be yes or no, got '${text}'")
    endif()
endfunction()
function(fmt_pick out name text)
    list(FIND ARGN "${text}" at)
    if (at EQUAL -1)
        message(FATAL_ERROR "formats.tsv: ${name} must be one of ${ARGN}, got '${text}'")
    endif()
    string(TOUPPER "${text}" v)
    string(REPLACE "-" "_" v "${v}")
    set(${out} "${v}" PARENT_SCOPE)
endfunction()

file(STRINGS "${FORMATS}" lines)
set(rows "")
set(checks "")
set(first 1)
foreach(line IN LISTS lines)
    if (line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if (first)
        set(first 0)
        continue()
    endif()
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if (NOT n EQUAL 17)
        message(FATAL_ERROR "formats.tsv: expected 17 cells, got ${n}: ${line}")
    endif()
    list(GET f 0 type)
    list(GET f 1 nsg)
    list(GET f 2 nr0)
    list(GET f 3 rows_per)
    list(GET f 4 smem)
    list(GET f 5 bytes)
    list(GET f 6 nr0_pipe)
    list(GET f 7 recompile)
    list(GET f 8 matvec)
    list(GET f 9 ext)
    list(GET f 10 tiled)
    list(GET f 11 w64)
    list(GET f 12 grouped)
    list(GET f 13 shape_rows)
    list(GET f 14 act_bf16)
    list(GET f 15 act_f16)
    list(GET f 16 ext_wide)
    string(TOUPPER "${type}" id)
    if (nsg STREQUAL "-" AND nr0 STREQUAL "-")
        set(nsg 0)
        set(nr0 0)
    elseif (nsg MATCHES "^[0-9]+$" AND nr0 MATCHES "^[0-9]+$")
        string(APPEND checks "static_assert(N_SG_${id} == ${nsg} && N_R0_${id} == ${nr0}, \"formats.tsv row ${type}: nsg, nr0 differ from ggml-metal-impl.h\");\n")
    else()
        message(FATAL_ERROR "formats.tsv: nsg and nr0 of ${type} must both be numbers or both be -")
    endif()
    if (NOT bytes MATCHES "^[0-9]+$")
        message(FATAL_ERROR "formats.tsv: bytes of ${type} must be a number")
    endif()
    fmt_pick(rp "rows_per" "${rows_per}" simdgroup threadgroup)
    if (rp STREQUAL "THREADGROUP")
        set(rp 1)
    else()
        set(rp 0)
    endif()
    fmt_pick(sm "smem" "${smem}" none bytes lane-floats row-sums)
    fmt_pick(ex "ext" "${ext}" no small kquant)
    fmt_flag(v_pipe "nr0_from_pipeline" "${nr0_pipe}")
    fmt_flag(v_rec "reduce_recompile_below_32" "${recompile}")
    fmt_flag(v_mv "matvec" "${matvec}")
    fmt_flag(v_tiled "tiled" "${tiled}")
    fmt_flag(v_w64 "w64_fallback" "${w64}")
    fmt_flag(v_grp "grouped" "${grouped}")
    fmt_flag(v_shape "shape_rows" "${shape_rows}")
    fmt_flag(v_abf "act_bf16" "${act_bf16}")
    fmt_pick(v_af16 "act_f16" "${act_f16}" no yes mm)
    fmt_flag(v_wide "ext_wide" "${ext_wide}")
    string(APPEND rows "    { GGML_TYPE_${id}, ${nsg}, ${nr0}, ${rp}, MV_SMEM_${sm}, ${bytes}, ${v_pipe}, ${v_rec}, ${v_mv}, MV_EXT_${ex}, ${v_tiled}, ${v_w64}, ${v_grp}, ${v_shape}, ${v_abf}, MV_ACT_${v_af16}, ${v_wide} },\n")
endforeach()

set(text "// generated from matmul/formats.tsv by matmul/gen-formats.cmake; do not edit\n#pragma once\n\nstatic const struct mv_format_row mv_format_rows[] = {\n${rows}};\n\n#ifdef GGML_METAL_MV_FORMATS_CHECK\n${checks}#endif\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
