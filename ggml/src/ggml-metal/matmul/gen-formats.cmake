# Turns section [formats] of data/matmul.tsv into mv-formats-table.h. Run: cmake -DTABLE=.../data/matmul.tsv -DOUT=... -P gen-formats.cmake
# The policies of CMake 3.14 (the project's minimum), so that a quoted word in if() is a string under CMake 3.x too.
cmake_policy(VERSION 3.14)
include("${CMAKE_CURRENT_LIST_DIR}/../data/tsv-read.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/matmul-sections.cmake")
function(fmt_flag out name text)
    if (text STREQUAL "yes")
        set(${out} 1 PARENT_SCOPE)
    elseif (text STREQUAL "no")
        set(${out} 0 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "matmul.tsv [formats]: ${name} must be yes or no, got '${text}'")
    endif()
endfunction()
function(fmt_pick out name text)
    list(FIND ARGN "${text}" at)
    if (at EQUAL -1)
        message(FATAL_ERROR "matmul.tsv [formats]: ${name} must be one of ${ARGN}, got '${text}'")
    endif()
    string(TOUPPER "${text}" v)
    string(REPLACE "-" "_" v "${v}")
    set(${out} "${v}" PARENT_SCOPE)
endfunction()

tsv_section("${TABLE}" formats "${matmul_sections}" lines)
set(rows "")
set(checks "")
set(seen "")
set(first 1)
foreach(line IN LISTS lines)
    string(REPLACE "\t" ";" f "${line}")
    if (first)
        set(first 0)
        if (NOT "${f}" STREQUAL "${matmul_formats_header}")
            tsv_text("${line}" shown)
            string(REPLACE ";" " " want "${matmul_formats_header}")
            message(FATAL_ERROR "matmul.tsv [formats]: the first row must be the header, tab-separated: ${want}; got: ${shown}")
        endif()
        continue()
    endif()
    list(LENGTH f n)
    if (NOT n EQUAL 17)
        message(FATAL_ERROR "matmul.tsv [formats]: expected 17 cells, got ${n}: ${line}")
    endif()
    list(GET f 0 type)
    list(GET f 1 nsg)
    list(GET f 2 nr0)
    list(GET f 3 rows_per)
    list(GET f 4 smem)
    list(GET f 5 bytes)
    list(GET f 6 nr0_pipe)
    list(GET f 7 recompile)
    list(GET f 8 matvec)
    list(GET f 9 ext)
    list(GET f 10 tiled)
    list(GET f 11 w64)
    list(GET f 12 grouped)
    list(GET f 13 shape_rows)
    list(GET f 14 act_bf16)
    list(GET f 15 act_f16)
    list(GET f 16 ext_wide)
    # one row per ggml type: two spellings of one type (q4_K, q4_k) are the same row
    string(TOUPPER "${type}" id)
    list(FIND seen "${id}" at)
    if (NOT at EQUAL -1)
        message(FATAL_ERROR "matmul.tsv [formats]: two rows for the weight ${type} (GGML_TYPE_${id})")
    endif()
    list(APPEND seen "${id}")
    if (nsg STREQUAL "-" AND nr0 STREQUAL "-")
        set(nsg 0)
        set(nr0 0)
    elseif (nsg MATCHES "^[0-9]+$" AND nr0 MATCHES "^[0-9]+$")
        string(APPEND checks "static_assert(N_SG_${id} == ${nsg} && N_R0_${id} == ${nr0}, \"matmul.tsv [formats] row ${type}: nsg, nr0 differ from ggml-metal-impl.h\");\n")
    else()
        message(FATAL_ERROR "matmul.tsv [formats]: nsg and nr0 of ${type} must both be numbers or both be -")
    endif()
    if (smem STREQUAL "bytes")
        if (NOT bytes MATCHES "^[1-9][0-9]?[0-9]?[0-9]?[0-9]?[0-9]?$")
            message(FATAL_ERROR "matmul.tsv [formats]: bytes of ${type} must be a number from 1 (smem is bytes), got '${bytes}'")
        endif()
    elseif (NOT bytes STREQUAL "0")
        message(FATAL_ERROR "matmul.tsv [formats]: bytes of ${type} must be 0 (smem is not bytes), got '${bytes}'")
    endif()
    fmt_pick(rp "rows_per" "${rows_per}" simdgroup threadgroup)
    if (rp STREQUAL "THREADGROUP")
        set(rp 1)
    else()
        set(rp 0)
    endif()
    fmt_pick(sm "smem" "${smem}" none bytes lane-floats row-sums)
    fmt_pick(ex "ext" "${ext}" no small kquant)
    fmt_flag(v_pipe "nr0_from_pipeline" "${nr0_pipe}")
    fmt_flag(v_rec "reduce_recompile_below_32" "${recompile}")
    fmt_flag(v_mv "matvec" "${matvec}")
    fmt_flag(v_tiled "tiled" "${tiled}")
    fmt_flag(v_w64 "w64_fallback" "${w64}")
    fmt_flag(v_grp "grouped" "${grouped}")
    fmt_flag(v_shape "shape_rows" "${shape_rows}")
    fmt_flag(v_abf "act_bf16" "${act_bf16}")
    fmt_pick(v_af16 "act_f16" "${act_f16}" no yes mm)
    fmt_flag(v_wide "ext_wide" "${ext_wide}")
    string(APPEND rows "    { GGML_TYPE_${id}, ${nsg}, ${nr0}, ${rp}, MV_SMEM_${sm}, ${bytes}, ${v_pipe}, ${v_rec}, ${v_mv}, MV_EXT_${ex}, ${v_tiled}, ${v_w64}, ${v_grp}, ${v_shape}, ${v_abf}, MV_ACT_${v_af16}, ${v_wide} },\n")
endforeach()

set(text "// generated from data/matmul.tsv [formats] by matmul/gen-formats.cmake; do not edit\n#pragma once\n\nstatic const struct mv_format_row mv_format_rows[] = {\n${rows}};\n\n#ifdef GGML_METAL_MV_FORMATS_CHECK\n${checks}#endif\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
