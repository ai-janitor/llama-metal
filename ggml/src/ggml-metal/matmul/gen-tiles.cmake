# Turns section [tiles] of data/matmul.tsv into the four generated files of the batch route and the tiled work plan:
#   OUT_ROUTES  batch-routes-table.h    the thresholds of the tuned rows (matmul/batch-route.cpp)
#   OUT_PLAN    tiled-plan-table.h      the plans of the tuned rows (matmul/tiled-plan.cpp)
#   OUT_H       tiled-compiled-table.h  the compiled plans and their names, the default first (matmul/tiled-plan.cpp)
#   OUT_METAL   tiled-plans.metal       one namespace block per compiled plan (matmul/kernel-tiled.metal)
# Run: cmake -DTABLE=.../data/matmul.tsv [-DOUT_ROUTES=...] [-DOUT_PLAN=...] [-DOUT_H=...] [-DOUT_METAL=...] -P gen-tiles.cmake
# An output that is not named is not written. Section [formats] of the same table says which weight types have a
# small-batch and a tiled kernel.
# The policies of CMake 3.14 (the project's minimum), so that a quoted word in if() is a string under CMake 3.x too.
cmake_policy(VERSION 3.14)
include("${CMAKE_CURRENT_LIST_DIR}/../data/tsv-read.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/matmul-sections.cmake")
set(fields ${matmul_tiles_fields})
# Bounds per field, same order; the rule (matmul/tiled-plan.cpp) holds the same numbers.
set(mins 1 1 1 1 32 1 1 1 2 1 0)
set(maxs 1024 1024 1024 1024 32 1024 1024 8 8 16 64)
set(plans_max 16)
# Tuned plans one card may carry (GGML_METAL_CARD_TILED_MAX, card-object.h).
set(card_max 32)
# The default plan, in field order: the layout the rule returns for a card with no tuned plan (matmul/tiled-plan.cpp).
set(default_values "32_128_64_64_32_32_32_2_4_2_1")
# The largest sums block and row cache of a thread (matmul/tiled-plan.cpp tiled_sums_max, tiled_rows_max).
set(sums_max 16)
set(rows_cache_max 8)

# Refuses the row; the message names the condition the kernel needs.
macro(refuse what)
    message(FATAL_ERROR "matmul.tsv [tiles]: plan ${plan} cannot run in the kernel (geometry): it needs ${what}: ${shown}")
endmacro()

tsv_section("${TABLE}" formats "${matmul_sections}" flines)
set(first 1)
set(known "")
set(known_ids "")
foreach(line IN LISTS flines)
    if (first)
        set(first 0)
        continue()
    endif()
    string(REPLACE "\t" ";" f "${line}")
    list(GET f 0 type)
    list(GET f 9 ext)
    list(GET f 10 tiled)
    string(TOUPPER "${type}" type_id)
    list(FIND known_ids "${type_id}" at)
    if (NOT at EQUAL -1)
        message(FATAL_ERROR "matmul.tsv [formats]: two rows for the weight ${type} (GGML_TYPE_${type_id})")
    endif()
    list(APPEND known_ids "${type_id}")
    list(APPEND known "${type}")
    set(ext_of_${type} "${ext}")
    set(tiled_of_${type} "${tiled}")
endforeach()

tsv_section("${TABLE}" tiles "${matmul_sections}" lines)
set(route_rows "")
set(tuned_n 0)       # tuned rows with a plan; row i: tuned_id_<i> (values id), tuned_before_<i>, tuned_after_<i> (its C cells around the plan index)
set(order "")         # the values ids of the plans, in the order they first appear
set(seen_names "")
set(seen_keys "")
set(cards "")
set(defaults 0)
set(first 1)
foreach(line IN LISTS lines)
    tsv_text("${line}" shown)
    string(REPLACE "\t" ";" f "${line}")
    if (first)
        set(first 0)
        if (NOT "${f}" STREQUAL "${matmul_tiles_header}")
            string(REPLACE ";" " " want "${matmul_tiles_header}")
            message(FATAL_ERROR "matmul.tsv [tiles] (${TABLE}): the first row must be the header, tab-separated: ${want}; got: ${shown}")
        endif()
        continue()
    endif()
    list(LENGTH f n)
    if (NOT n EQUAL 24)
        message(FATAL_ERROR "matmul.tsv [tiles]: expected 24 cells, got ${n}: ${shown}")
    endif()
    list(GET f 0 card_cell)
    tsv_text("${card_cell}" card)
    list(GET f 1 weight)
    list(GET f 2 plan)
    list(GET f 3 plan_cols)
    list(GET f 4 role)
    list(GET f 5 ext_from)
    list(GET f 6 tiled_from)
    list(GET f 7 wave)
    list(GET f 8 group_bytes)
    list(GET f 20 route_source)
    list(GET f 21 route_test)
    list(GET f 22 plan_source)
    list(GET f 23 plan_test)
    if (NOT role MATCHES "^(tuned|default|candidate)$")
        message(FATAL_ERROR "matmul.tsv [tiles]: role must be tuned, default or candidate: ${shown}")
    endif()
    # plan_cols: - (every column count) or one count. A range is not a form: a row is a measured count.
    if (plan_cols STREQUAL "-")
        set(pc 0)
    elseif (plan_cols MATCHES "^[1-9][0-9]?[0-9]?[0-9]?[0-9]?[0-9]?[0-9]?[0-9]?[0-9]?$" AND plan_cols GREATER 1)
        set(pc ${plan_cols})
    else()
        message(FATAL_ERROR "matmul.tsv [tiles]: plan_cols is - or one column count from 2 with at most 9 digits, written without a leading zero (a range is not a form): ${shown}")
    endif()

    # The eleven values: all given with a plan, all - without one.
    set(given 0)
    foreach(i RANGE 0 10)
        math(EXPR cell "${i} + 9")
        list(GET f ${cell} value)
        if (NOT value STREQUAL "-")
            math(EXPR given "${given} + 1")
        endif()
    endforeach()
    if (plan STREQUAL "-")
        if (NOT given EQUAL 0)
            message(FATAL_ERROR "matmul.tsv [tiles]: a row without a plan name gives no plan values (warp to pad are all -): ${shown}")
        endif()
        set(id "")
    else()
        if (NOT given EQUAL 11)
            message(FATAL_ERROR "matmul.tsv [tiles]: a plan needs all eleven values from warp to pad: ${shown}")
        endif()
        if (NOT plan MATCHES "^[a-z0-9_]+$")
            message(FATAL_ERROR "matmul.tsv [tiles]: a plan name is lower-case letters, digits and _: ${shown}")
        endif()
        set(id "")
        set(vals "")
        set(consts "")
        foreach(i RANGE 0 10)
            math(EXPR cell "${i} + 9")
            list(GET f ${cell} value)
            list(GET fields ${i} field)
            if (NOT value MATCHES "^(0|[1-9][0-9]*)$")
                message(FATAL_ERROR "matmul.tsv [tiles]: ${field} must be a whole number with no leading zero: ${shown}")
            endif()
            string(LENGTH "${value}" digits)
            list(GET mins ${i} lo)
            list(GET maxs ${i} hi)
            if (digits GREATER 4 OR value LESS lo OR value GREATER hi)
                message(FATAL_ERROR "matmul.tsv [tiles]: ${field} is out of range ${lo}..${hi}: ${shown}")
            endif()
            set(v_${field} "${value}")
            if (i EQUAL 0)
                set(id "${value}")
                set(vals "${value}")
            else()
                string(APPEND id "_${value}")
                string(APPEND vals ", ${value}")
            endif()
            string(APPEND consts "constant constexpr uint tiled_${field} = ${value};\n")
        endforeach()
        # The kernel's own arithmetic, as in ggml_metal_tiled_plan_check (matmul/tiled-plan.cpp), without the card's facts.
        math(EXPR r_tm "${v_tm} % 2")
        math(EXPR r_warp "${v_threads} % ${v_warp}")
        math(EXPR r_wm "${v_bm} % ${v_wm}")
        math(EXPR r_wn "${v_bn} % ${v_wn}")
        if (NOT r_tm EQUAL 0)
            refuse("tm even")
        endif()
        if (NOT r_warp EQUAL 0)
            refuse("warp to divide threads")
        endif()
        if (NOT r_wm EQUAL 0 OR NOT r_wn EQUAL 0)
            refuse("the warp tile to divide the group tile")
        endif()
        math(EXPR tiles "(${v_bm} / ${v_wm}) * (${v_bn} / ${v_wn})")
        math(EXPR warps "${v_threads} / ${v_warp}")
        if (NOT tiles EQUAL warps)
            refuse("one warp per warp tile (${tiles} warp tiles, ${warps} warps)")
        endif()
        math(EXPR per_pass "${v_warp} * ${v_tm} * ${v_tn} * ${v_wmiter}")
        math(EXPR r_pass "(${v_wm} * ${v_wn}) % ${per_pass}")
        math(EXPR wniter "(${v_wm} * ${v_wn}) / ${per_pass}")
        if (NOT r_pass EQUAL 0 OR wniter LESS 1)
            refuse("wm * wn / (warp * tm * tn * wmiter) a whole number from 1")
        endif()
        math(EXPR r_wmiter "${v_wm} % ${v_wmiter}")
        math(EXPR r_wniter "${v_wn} % ${wniter}")
        if (NOT r_wmiter EQUAL 0 OR NOT r_wniter EQUAL 0)
            refuse("the passes to divide the warp tile")
        endif()
        math(EXPR r_stride "(${v_threads} * 2) % ${v_bk}")
        math(EXPR load_stride "${v_threads} * 2 / ${v_bk}")
        if (NOT r_stride EQUAL 0 OR load_stride LESS 1)
            refuse("threads * 2 / bk a whole number from 1")
        endif()
        math(EXPR wsubm "${v_wm} / ${v_wmiter}")
        math(EXPR wsubn "${v_wn} / ${wniter}")
        math(EXPR r_subm "${wsubm} % ${v_tm}")
        math(EXPR r_subn "${wsubn} % ${v_tn}")
        math(EXPR blocks "(${wsubm} / ${v_tm}) * (${wsubn} / ${v_tn})")
        if (NOT r_subm EQUAL 0 OR NOT r_subn EQUAL 0 OR NOT blocks EQUAL v_warp)
            refuse("its own block of sums for every thread of a warp")
        endif()
        math(EXPR r_fm "${v_bm} % ${load_stride}")
        math(EXPR r_fn "${v_bn} % ${load_stride}")
        if (NOT r_fm EQUAL 0 OR NOT r_fn EQUAL 0)
            refuse("both tiles multiples of the fill stride ${load_stride}")
        endif()
        math(EXPR sums "${v_wmiter} * ${v_tm} * ${wniter} * ${v_tn} / 2")
        math(EXPR cache "${v_wmiter} * ${v_tm}")
        if (sums GREATER sums_max OR cache GREATER rows_cache_max)
            refuse("at most ${sums_max} float2 sums and ${rows_cache_max} cached rows per thread")
        endif()
        if (NOT plan MATCHES "^${v_bm}x${v_bn}_t${v_threads}(_[a-z0-9_]+)?$")
            message(FATAL_ERROR "matmul.tsv [tiles]: the plan name ${plan} must start with ${v_bm}x${v_bn}_t${v_threads} (its bm, bn and threads): ${shown}")
        endif()
        if (plan_source STREQUAL "" OR plan_source STREQUAL "-")
            message(FATAL_ERROR "matmul.tsv [tiles]: the plan ${plan} names no source (plan_source): ${shown}")
        endif()
        # One name per set of values, one set of values per name.
        list(FIND order "${id}" at)
        if (at EQUAL -1)
            list(FIND seen_names "${plan}" dupname)
            if (NOT dupname EQUAL -1)
                message(FATAL_ERROR "matmul.tsv [tiles]: two sets of values with the plan name ${plan}: ${shown}")
            endif()
            list(APPEND order "${id}")
            list(APPEND seen_names "${plan}")
            set(name_${id} "${plan}")
            set(vals_${id} "${vals}")
            set(consts_${id} "${consts}")
        elseif (NOT name_${id} STREQUAL plan)
            message(FATAL_ERROR "matmul.tsv [tiles]: two names for the plan ${id}: ${name_${id}} and ${plan}")
        endif()
    endif()

    if (role STREQUAL "tuned")
        # The card's Metal device name, compared whole at run time: no empty name, no space at either end, nothing that
        # would need escaping in the generated C string, at most 62 bytes (see tsv_card in data/tsv-read.cmake).
        string(LENGTH "${card}" card_len)
        if (card STREQUAL "" OR card STREQUAL "any" OR card MATCHES "^ " OR card MATCHES " $" OR card MATCHES "[\"\\\\]" OR card_len GREATER 62)
            message(FATAL_ERROR "matmul.tsv [tiles]: card must be the Metal device name as the log prints it after 'found device: ' (not empty, no space at either end, no quote or backslash, at most 62 bytes: the device keeps 63 bytes of its name and a name that long may be cut short): ${shown}")
        endif()
        if (weight STREQUAL "any")
            set(wt "-1")
        else()
            list(FIND known "${weight}" at)
            if (at EQUAL -1)
                message(FATAL_ERROR "matmul.tsv [tiles]: weight '${weight}' has no row in [formats]: ${shown}")
            endif()
            string(TOUPPER "${weight}" wid)
            set(wt "GGML_TYPE_${wid}")
        endif()
        # One row per card, weight and plan_cols: the row for every count never collides with a row for one count.
        list(FIND seen_keys "${card_cell}\t${weight}\t${plan_cols}" at)
        if (NOT at EQUAL -1)
            if (pc EQUAL 0)
                message(FATAL_ERROR "matmul.tsv [tiles]: two rows for ${card} ${weight}")
            else()
                message(FATAL_ERROR "matmul.tsv [tiles]: two rows for ${card} ${weight} at ${plan_cols} columns")
            endif()
        endif()
        list(APPEND seen_keys "${card_cell}\t${weight}\t${plan_cols}")
        if (pc GREATER 0 AND (plan STREQUAL "-" OR NOT ext_from STREQUAL "-" OR NOT tiled_from STREQUAL "-" OR NOT route_source STREQUAL "-" OR NOT route_test STREQUAL "-"))
            message(FATAL_ERROR "matmul.tsv [tiles]: a row for one column count holds a plan and no threshold (ext_from, tiled_from, route_source, route_test are -): ${shown}")
        endif()
        foreach(cell wave group_bytes)
            string(LENGTH "${${cell}}" digits)
            if (NOT "${${cell}}" MATCHES "^[1-9][0-9]*$" OR digits GREATER 9)
                message(FATAL_ERROR "matmul.tsv [tiles]: ${cell} of a tuned row is the number the card reports: ${shown}")
            endif()
        endforeach()
        if (ext_from STREQUAL "-")
            set(ef 0)
        elseif (ext_from MATCHES "^[2-9]$")
            if (weight STREQUAL "any" OR ext_of_${weight} STREQUAL "no")
                message(FATAL_ERROR "matmul.tsv [tiles]: ${weight} has no small-batch kernel, ext_from must be -: ${shown}")
            endif()
            set(ef ${ext_from})
        else()
            message(FATAL_ERROR "matmul.tsv [tiles]: ext_from of ${card} ${weight} must be 2..9 or -")
        endif()
        if (tiled_from STREQUAL "-")
            set(tf 0)
        elseif (tiled_from MATCHES "^[1-9][0-9]?[0-9]?[0-9]?[0-9]?[0-9]?[0-9]?[0-9]?[0-9]?$" AND tiled_from GREATER 1)
            if (weight STREQUAL "any" OR NOT tiled_of_${weight} STREQUAL "yes")
                message(FATAL_ERROR "matmul.tsv [tiles]: ${weight} has no tiled kernel, tiled_from must be -: ${shown}")
            endif()
            if (ef GREATER 0 AND NOT tiled_from GREATER ef)
                message(FATAL_ERROR "matmul.tsv [tiles]: tiled_from of ${card} ${weight} must be above its ext_from")
            endif()
            set(tf ${tiled_from})
        else()
            message(FATAL_ERROR "matmul.tsv [tiles]: tiled_from of ${card} ${weight} must be a column count from 2 with at most 9 digits, written without a leading zero, or -")
        endif()
        if (ef EQUAL 0 AND tf EQUAL 0 AND plan STREQUAL "-")
            message(FATAL_ERROR "matmul.tsv [tiles]: a tuned row holds a threshold, a plan, or both: ${shown}")
        endif()
        if (ef GREATER 0 OR tf GREATER 0)
            if (route_source STREQUAL "" OR route_source STREQUAL "-")
                message(FATAL_ERROR "matmul.tsv [tiles]: ${card} ${weight} names no source for its thresholds (route_source)")
            endif()
            if (route_test STREQUAL "" OR route_test STREQUAL "-")
                message(FATAL_ERROR "matmul.tsv [tiles]: ${card} ${weight} names no command that proves its thresholds (route_test)")
            endif()
            string(APPEND route_rows "    { \"${card}\", ${wt}, ${ef}, ${tf} },\n")
        endif()
        if (NOT plan STREQUAL "-")
            if (NOT weight STREQUAL "any" AND NOT tiled_of_${weight} STREQUAL "yes")
                message(FATAL_ERROR "matmul.tsv [tiles]: weight '${weight}' has no tiled kernel in [formats], the row can name no plan: ${shown}")
            endif()
            list(APPEND cards "${card_cell}")
            set(count 0)
            foreach(c IN LISTS cards)
                if ("${c}" STREQUAL "${card_cell}")
                    math(EXPR count "${count} + 1")
                endif()
            endforeach()
            if (count GREATER card_max)
                message(FATAL_ERROR "matmul.tsv [tiles]: more than ${card_max} tuned plans for ${card}")
            endif()
            if (plan_test STREQUAL "" OR plan_test STREQUAL "-")
                message(FATAL_ERROR "matmul.tsv [tiles]: ${card} ${weight} names no command that proves its plan (plan_test): ${shown}")
            endif()
            # The card's facts of ggml_metal_tiled_plan_check (matmul/tiled-plan.cpp), with the shape written in the row:
            # a plan its own card would refuse never runs there.
            math(EXPR r_wave "${v_threads} % ${wave}")
            math(EXPR need_bytes "(${v_bm} + ${v_bn}) * (${v_bk} / 2 + ${v_pad}) * 8")
            if (NOT r_wave EQUAL 0)
                message(FATAL_ERROR "matmul.tsv [tiles]: the plan ${plan} cannot run on the card of its own row: its ${v_threads} threads are not whole waves of ${wave}: ${shown}")
            endif()
            if (need_bytes GREATER group_bytes)
                message(FATAL_ERROR "matmul.tsv [tiles]: the plan ${plan} cannot run on the card of its own row: it needs ${need_bytes} bytes of group memory, the row says the card allows ${group_bytes}: ${shown}")
            endif()
            math(EXPR tuned_n "${tuned_n} + 1")
            set(tuned_id_${tuned_n} "${id}")
            set(tuned_before_${tuned_n} "    { \"${card}\", ${wt}, ")
            set(tuned_after_${tuned_n} ", ${pc}, ${wave}, ${group_bytes} },")
        endif()
    else()
        if (NOT card STREQUAL "any" OR NOT weight STREQUAL "any" OR plan STREQUAL "-")
            message(FATAL_ERROR "matmul.tsv [tiles]: a ${role} row has card any, weight any and a plan: ${shown}")
        endif()
        if (NOT ext_from STREQUAL "-" OR NOT tiled_from STREQUAL "-" OR NOT wave STREQUAL "-" OR NOT group_bytes STREQUAL "-")
            message(FATAL_ERROR "matmul.tsv [tiles]: a ${role} row has no thresholds, wave or group_bytes (all -): ${shown}")
        endif()
        if (NOT pc EQUAL 0)
            message(FATAL_ERROR "matmul.tsv [tiles]: a ${role} row has plan_cols -: ${shown}")
        endif()
        if (role STREQUAL "default")
            math(EXPR defaults "${defaults} + 1")
            if (NOT id STREQUAL "${default_values}")
                message(FATAL_ERROR "matmul.tsv [tiles]: the default row must hold the default plan (values ${default_values}): ${shown}")
            endif()
        endif()
    endif()
endforeach()
if (first)
    message(FATAL_ERROR "matmul.tsv [tiles] (${TABLE}): the section has no header row")
endif()
if (NOT defaults EQUAL 1)
    message(FATAL_ERROR "matmul.tsv [tiles]: exactly one row has the role default, found ${defaults}")
endif()

# The compiled plans: the default first, then the others in the order they first appear.
list(REMOVE_ITEM order "${default_values}")
list(INSERT order 0 "${default_values}")
list(LENGTH order count)
if (count GREATER plans_max)
    message(FATAL_ERROR "matmul.tsv [tiles]: more than ${plans_max} plans")
endif()
set(host "")
set(ids "")
set(metal "")
foreach(id IN LISTS order)
    string(APPEND host "    { ${vals_${id}} },\n")
    string(APPEND ids "    \"${name_${id}}\",\n")
    string(APPEND metal "namespace tiled_${id} {\n#define TILED_PLAN_NAME \"_lay_${id}\"\n${consts_${id}}#include \"kernel-tiled-body.metal\"\n#undef TILED_PLAN_NAME\n}\n")
endforeach()
set(plan_rows "")
set(i 0)
while (i LESS tuned_n)
    math(EXPR i "${i} + 1")
    list(FIND order "${tuned_id_${i}}" at)
    string(APPEND plan_rows "${tuned_before_${i}}${at}${tuned_after_${i}}\n")
endwhile()

set(text_OUT_ROUTES "// generated from data/matmul.tsv [tiles] by matmul/gen-tiles.cmake; do not edit\n#pragma once\n\n// { the card's Metal device name, weight type, ext_from, tiled_from }; 0 = the cell is -; the last row is the end mark\nstatic const struct mv_batch_row mv_batch_rows[] = {\n${route_rows}    { \"\", GGML_TYPE_COUNT, 0, 0 },\n};\n")
set(text_OUT_PLAN "// generated from data/matmul.tsv [tiles] by matmul/gen-tiles.cmake; do not edit\n#pragma once\n\n// { the card's Metal device name, weight type or -1 for every type, row of the compiled plan, the column count the plan is for or 0 for every count, the wave width and group memory the row was measured with }; the last row (plan -1) is the end mark\nstatic const struct ggml_metal_tiled_tune_row tiled_tune_rows[] = {\n${plan_rows}    { \"\", 0, -1, 0, 0, 0 },\n};\n")
set(text_OUT_H "// generated from data/matmul.tsv [tiles] by matmul/gen-tiles.cmake; do not edit\n#pragma once\n\n// The plans the tiled kernel is compiled for, in the field order of struct ggml_metal_tiled_plan; row 0 is the default.\nstatic const int32_t tiled_compiled[][GGML_METAL_TILED_PLAN_N] = {\n${host}};\n\n// The id of each row.\nstatic const char * const tiled_compiled_id[] = {\n${ids}};\n")
set(text_OUT_METAL "// generated from data/matmul.tsv [tiles] by matmul/gen-tiles.cmake; do not edit\n${metal}")
foreach(var OUT_ROUTES OUT_PLAN OUT_H OUT_METAL)
    if (NOT DEFINED ${var})
        continue()
    endif()
    if (EXISTS "${${var}}")
        file(READ "${${var}}" old)
    else()
        set(old "")
    endif()
    if (NOT old STREQUAL "${text_${var}}")
        file(WRITE "${${var}}" "${text_${var}}")
    endif()
endforeach()
