# Turns a section [launches] into an ids header (one id per launch) and a rows header.
# Run: cmake -DTABLE=.../data/device.tsv -DOUT_IDS=... -DOUT_ROWS=... -P gen-launches.cmake
# That reads data/device.tsv. For the section of another table also give: -DLABEL=<file name for messages>
# -DKNOWN=<the table's sections, comma-separated> -DPREFIX=<prefix of the ids> -DSYMBOL=<prefix of the C names>
# -DRULES=<the table's rules file>. The rules file (device/launch-rules.cmake for data/device.tsv) says per launch
# which cells it reads and which values its code runs; its header gives the form. A table is refused when a launch has
# no rule, a default row leaves a read cell -, a row writes a cell the launch does not read or a value outside its rule.
# The ids header changes only when a launch is added, removed or moved; a changed number rewrites the rows header alone.
# The rows header is included after device/launch-plan.h, which declares struct ggml_metal_launch_row.
cmake_policy(VERSION 3.14)
include("${CMAKE_CURRENT_LIST_DIR}/../data/tsv-read.cmake")
if (NOT DEFINED LABEL)
    set(LABEL "device.tsv")
    set(KNOWN "devices,families,launches")
    set(PREFIX "GGML_METAL_LAUNCH")
    set(SYMBOL "ggml_metal_launch")
endif()
string(REPLACE "," ";" device_sections "${KNOWN}")
set(launch_header "launch;card;wave;start;work_min;cap;nsg;units;mem_units;evidence")
set(launch_cols start work_min cap nsg units mem_units)
set(where "${LABEL} [launches]")
if (NOT DEFINED RULES)
    set(RULES "${CMAKE_CURRENT_LIST_DIR}/launch-rules.cmake")
endif()
get_filename_component(rules_label "${RULES}" NAME)
set(ruled "")
# one line of a rules file: the launch reads the cell, and takes the values of the rule (data/tsv-read.cmake tsv_bound)
function(launch_rule launch cell)
    list(FIND launch_cols "${cell}" at)
    if (at EQUAL -1)
        message(FATAL_ERROR "${rules_label}: ${launch} ${cell}: the cell is one of start, work_min, cap, nsg, units, mem_units")
    endif()
    if (DEFINED rule_${launch}_${cell})
        message(FATAL_ERROR "${rules_label}: ${launch} ${cell}: two rules")
    endif()
    tsv_rule_form("${ARGN}" "${rules_label}: ${launch} ${cell}")
    set(rule_${launch}_${cell} "${ARGN}" PARENT_SCOPE)
    set(ruled "${ruled};${launch}" PARENT_SCOPE)
endfunction()
include("${RULES}")

# a number cell: a whole number from 1, - (given back as -1), or, where the column takes it, wave (-2)
function(launch_cell cell row_where name out)
    if ("${name}" STREQUAL "start" OR "${name}" STREQUAL "mem_units")
        if ("${cell}" STREQUAL "wave")
            set(${out} "-2" PARENT_SCOPE)
            return()
        endif()
        if (NOT "${cell}" STREQUAL "-" AND NOT "${cell}" MATCHES "^[1-9][0-9]*$")
            tsv_text("${cell}" shown)
            message(FATAL_ERROR "${row_where}: ${name} is a whole number from 1, wave, or -; got '${shown}'")
        endif()
    endif()
    tsv_number("${cell}" "${row_where}" "${name}" 1048576 v)
    set(${out} "${v}" PARENT_SCOPE)
endfunction()

tsv_section("${TABLE}" launches "${device_sections}" lines)
set(names "")
set(n_over 0)
set(seen "")
set(rows "")
set(first 1)
foreach(line IN LISTS lines)
    if (first)
        set(first 0)
        tsv_header("${line}" "${launch_header}" "${where}")
        continue()
    endif()
    tsv_text("${line}" shown)
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if (NOT n EQUAL 10)
        message(FATAL_ERROR "${where}: expected 10 cells, got ${n}: ${shown}")
    endif()
    list(GET f 0 launch)
    list(GET f 1 card_cell)
    list(GET f 2 wave_cell)
    list(GET f 9 evidence)
    if (NOT "${launch}" MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "${where}: launch is a name in lower-case letters, digits and _, got: ${shown}")
    endif()
    set(row_where "${where} ${launch}")
    if ("${card_cell}" STREQUAL "any")
        set(card "")
    else()
        tsv_card("${card_cell}" "${row_where}" card)
    endif()
    if ("${wave_cell}" STREQUAL "any")
        set(v_wave -1)
    else()
        tsv_number("${wave_cell}" "${row_where}" "wave" 1024 v_wave)
        if (v_wave EQUAL -1)
            message(FATAL_ERROR "${row_where}: wave is any or a number, got -")
        endif()
    endif()
    if (NOT "${card}" STREQUAL "" AND v_wave EQUAL -1)
        message(FATAL_ERROR "${row_where}: a card's row writes the wave the card reports, not any")
    endif()
    if ("${evidence}" STREQUAL "" OR "${evidence}" STREQUAL "-")
        message(FATAL_ERROR "${row_where}: evidence says where the cells come from; it is empty")
    endif()
    set(key "${launch}|${card_cell}|${wave_cell}")
    list(FIND seen "${key}" at)
    if (NOT at EQUAL -1)
        message(FATAL_ERROR "${row_where}: two rows for card ${card_cell}, wave ${wave_cell}")
    endif()
    list(APPEND seen "${key}")
    set(is_default 0)
    if ("${card}" STREQUAL "" AND v_wave EQUAL -1)
        set(is_default 1)
    endif()
    list(FIND names "${launch}" id)
    if (is_default)
        list(LENGTH names id)
        list(APPEND names "${launch}")
    elseif (id EQUAL -1)
        message(FATAL_ERROR "${row_where}: the launch's default row (card any, wave any) comes before its other rows")
    endif()
    set(i 3)
    set(written 0)
    foreach(col IN LISTS launch_cols)
        list(GET f ${i} cell)
        launch_cell("${cell}" "${row_where}" "${col}" v_${col})
        if (NOT v_${col} EQUAL -1)
            set(written 1)
        endif()
        math(EXPR i "${i} + 1")
    endforeach()
    if (NOT written)
        message(FATAL_ERROR "${row_where}: the row writes no number")
    endif()
    if (v_start GREATER 0 AND v_cap GREATER 0 AND v_cap LESS v_start)
        message(FATAL_ERROR "${row_where}: cap ${v_cap} is below start ${v_start}")
    endif()
    list(FIND ruled "${launch}" at)
    if (at EQUAL -1)
        message(FATAL_ERROR "${row_where}: the launch has no launch_rule line in ${rules_label}")
    endif()
    foreach(col IN LISTS launch_cols)
        if (DEFINED rule_${launch}_${col})
            if (NOT v_${col} EQUAL -1)
                tsv_bound("${v_${col}}" "${rule_${launch}_${col}}" "${row_where}" "${col}")
            elseif (is_default)
                message(FATAL_ERROR "${row_where}: ${col} is - in the default row; the launch reads it (${rules_label})")
            endif()
        elseif (NOT v_${col} EQUAL -1)
            message(FATAL_ERROR "${row_where}: the launch does not read ${col}; write - (${rules_label})")
        endif()
    endforeach()
    # kept for the check of the rows together, after the loop
    if (is_default)
        set(def_${launch}_start "${v_start}")
        set(def_${launch}_cap "${v_cap}")
    else()
        if ("${card}" STREQUAL "")
            set(wv_${launch}_${v_wave}_start "${v_start}")
            set(wv_${launch}_${v_wave}_cap "${v_cap}")
        endif()
        set(o_${n_over}_launch "${launch}")
        set(o_${n_over}_card "${card_cell}")
        set(o_${n_over}_wave "${v_wave}")
        set(o_${n_over}_start "${v_start}")
        set(o_${n_over}_cap "${v_cap}")
        math(EXPR n_over "${n_over} + 1")
    endif()
    string(APPEND rows "    { ${id}, \"${card}\", ${v_wave}, ${v_start}, ${v_work_min}, ${v_cap}, ${v_nsg}, ${v_units}, ${v_mem_units} },\n")
endforeach()
if (first)
    message(FATAL_ERROR "${where}: the section has no header row")
endif()
# A card's numbers are its rows together (default, then the row of its wave, then its own row: device/launch-plan.cpp),
# so start and cap are held against each other on every such path, with wave read as the path's wave.
set(i 0)
while (i LESS n_over)
    set(launch "${o_${i}_launch}")
    set(w "${o_${i}_wave}")
    set(m_start "${def_${launch}_start}")
    set(m_cap "${def_${launch}_cap}")
    set(layers "o_${i}")
    if (NOT "${o_${i}_card}" STREQUAL "any" AND DEFINED wv_${launch}_${w}_start)
        set(layers "wv_${launch}_${w};o_${i}")
    endif()
    foreach(layer IN LISTS layers)
        foreach(col start cap)
            if (NOT ${layer}_${col} EQUAL -1)
                set(m_${col} "${${layer}_${col}}")
            endif()
        endforeach()
    endforeach()
    foreach(col start cap)
        if (m_${col} EQUAL -2)
            set(m_${col} "${w}")
        endif()
    endforeach()
    if (m_start GREATER 0 AND m_cap GREATER 0 AND m_cap LESS m_start)
        message(FATAL_ERROR "${where} ${launch}: cap ${m_cap} is below start ${m_start} with the rows of wave ${w} and card ${o_${i}_card} together")
    endif()
    math(EXPR i "${i} + 1")
endwhile()
foreach(launch IN LISTS ruled)
    list(FIND names "${launch}" at)
    if (NOT "${launch}" STREQUAL "" AND at EQUAL -1)
        message(FATAL_ERROR "${rules_label}: a rule names launch ${launch}, which has no default row in ${where}")
    endif()
endforeach()

set(enum "")
set(name_rows "")
foreach(name IN LISTS names)
    string(TOUPPER "${name}" upper)
    string(APPEND enum "    ${PREFIX}_${upper},\n")
    string(APPEND name_rows "    \"${name}\",\n")
endforeach()

set(ids_text "// generated from data/${LABEL} [launches] by device/gen-launches.cmake; do not edit
#pragma once

// One id per launch of the section, in the order of the default rows.
enum ${SYMBOL}_id {
${enum}    ${PREFIX}_COUNT
};
")
set(rows_text "// generated from data/${LABEL} [launches] by device/gen-launches.cmake; do not edit
#pragma once

// The rows: struct ggml_metal_launch_row of device/launch-plan.h. card \"\" = any; wave -1 = any. In the number
// cells -1 = the cell is -, -2 = the cell is wave. The last row is the end mark.
static const struct ggml_metal_launch_row ${SYMBOL}_rows[] = {
${rows}    { -1, 0, 0, 0, 0, 0, 0, 0, 0 },
};

// the launches' names by id; the last entry is the end mark
static const char * const ${SYMBOL}_names[] = {
${name_rows}    0,
};
")
foreach(pair "OUT_IDS;ids_text" "OUT_ROWS;rows_text")
    list(GET pair 0 out_var)
    list(GET pair 1 text_var)
    if (EXISTS "${${out_var}}")
        file(READ "${${out_var}}" old)
    else()
        set(old "")
    endif()
    if (NOT old STREQUAL ${text_var})
        file(WRITE "${${out_var}}" "${${text_var}}")
    endif()
endforeach()
