# Turns attention.tsv into routes-table.h ([routes]) and, when OUT_LAUNCH is given, fa-launch-table.h ([launch]).
# Run: cmake -DROUTES=... -DOUT=... [-DOUT_LAUNCH=...] -P gen-routes.cmake
# The cells are read by position, so each header row is required as written.
# The policies of CMake 3.14 (the project's minimum), so that a quoted word in if() is a string under CMake 3.x too.
cmake_policy(VERSION 3.14)
include("${CMAKE_CURRENT_LIST_DIR}/../data/tsv-read.cmake")
set(header "order;route;file;needs_matrix;vendor;width;batch;kv;fp8;head;note")
function(route_cell out name text yes no)
    if (text STREQUAL "any")
        set(${out} -1 PARENT_SCOPE)
    elseif (text STREQUAL "${yes}")
        set(${out} 1 PARENT_SCOPE)
    elseif (text STREQUAL "${no}")
        set(${out} 0 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "attention.tsv: ${name} must be ${yes}, ${no} or any, got '${text}'")
    endif()
endfunction()

tsv_section("${ROUTES}" routes "routes;launch" lines)
set(rows "")
set(first 1)
set(want 1)
foreach(line IN LISTS lines)
    string(REPLACE "\t" ";" f "${line}")
    if (first)
        set(first 0)
        if (NOT "${f}" STREQUAL "${header}")
            string(REPLACE ";" " " want "${header}")
            string(REPLACE ";" " " got "${f}")
            message(FATAL_ERROR "attention.tsv: the first row must be the header, tab-separated: ${want}; got: ${got}")
        endif()
        continue()
    endif()
    list(LENGTH f n)
    if (NOT n EQUAL 11)
        message(FATAL_ERROR "attention.tsv: expected 11 cells, got ${n}: ${line}")
    endif()
    list(GET f 0 order)
    list(GET f 1 route)
    list(GET f 3 matrix)
    list(GET f 4 vendor)
    list(GET f 5 width)
    list(GET f 6 batch)
    list(GET f 7 kv)
    list(GET f 8 fp8)
    list(GET f 9 head)
    if (NOT order EQUAL want)
        message(FATAL_ERROR "attention.tsv: order must count up from 1, got '${order}' where ${want} was due")
    endif()
    math(EXPR want "${want} + 1")
    if (NOT route MATCHES "^(intel-tiled|scalar|matrix|vec)$")
        message(FATAL_ERROR "attention.tsv: unknown route '${route}'")
    endif()
    string(TOUPPER "${route}" id)
    string(REPLACE "-" "_" id "${id}")
    route_cell(v_matrix "needs_matrix" "${matrix}" yes no)
    route_cell(v_intel "vendor" "${vendor}" intel not-intel)
    route_cell(v_w32 "width" "${width}" 32 not-32)
    route_cell(v_small "batch" "${batch}" small large)
    route_cell(v_same "kv" "${kv}" same differ)
    route_cell(v_fp8 "fp8" "${fp8}" yes no)
    if (head STREQUAL "any")
        set(head 0)
    elseif (NOT head MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "attention.tsv: head must be a number or any, got '${head}'")
    endif()
    string(APPEND rows "    { FA_ROUTE_${id}, ${v_matrix}, ${v_intel}, ${v_w32}, ${v_small}, ${v_same}, ${v_fp8}, ${head} },\n")
endforeach()
if (first)
    message(FATAL_ERROR "attention.tsv: the table has no header row")
endif()

set(text "// generated from data/attention.tsv by flash-attn/gen-routes.cmake; do not edit\n#pragma once\n\nstatic const struct fa_route_row fa_route_rows[] = {\n${rows}};\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()

# [launch]: the launch numbers of a route
if (DEFINED OUT_LAUNCH)
    set(launch_header "launch_route;card;wave;simdgroups;wide_simdgroups;wide_head;workgroups;small_queries;threads;evidence")
    set(launch_cols simdgroups wide_simdgroups wide_head workgroups small_queries threads)
    # the cells each route reads
    set(reads_scalar simdgroups)
    set(reads_vec simdgroups workgroups small_queries)
    set(reads_matrix simdgroups wide_simdgroups wide_head)
    set(reads_prepass threads)
    # the values each read cell takes (data/tsv-read.cmake tsv_bound): what the kernels and the size functions hold, or
    # what the code ran before the number was a row. To widen one, read the consumer named beside it first.
    set(bound_scalar_simdgroups "range;1;8")       # the route's threadgroup memory is sized for up to 8 x the wave
    set(bound_vec_simdgroups "oneof;1;2;4")        # they double from 1; the old code stopped at 4
    set(bound_vec_workgroups "oneof;32")           # the merge kernel reads one partial per thread of a simdgroup of 32
    set(bound_vec_small_queries "range;1;32")      # the workspace holds at most 32 queries (flash-attn/sizes.cpp)
    set(bound_matrix_simdgroups "oneof;4;8")       # the two counts the old code ran
    set(bound_matrix_wide_simdgroups "oneof;4;8")
    set(bound_matrix_wide_head "range;1;65536")    # compared with the head size only
    set(bound_prepass_threads "oneof;32")          # the number the old code ran
    set(where "attention.tsv [launch]")
    tsv_section("${ROUTES}" launch "routes;launch" lines)
    set(lrows "")
    set(seen "")
    set(have "")
    set(first 1)
    foreach(line IN LISTS lines)
        if (first)
            set(first 0)
            tsv_header("${line}" "${launch_header}" "${where}")
            continue()
        endif()
        tsv_text("${line}" shown)
        string(REPLACE "\t" ";" f "${line}")
        list(LENGTH f n)
        if (NOT n EQUAL 10)
            message(FATAL_ERROR "${where}: expected 10 cells, got ${n}: ${shown}")
        endif()
        list(GET f 0 route)
        list(GET f 1 card_cell)
        list(GET f 2 wave_cell)
        list(GET f 9 evidence)
        if (NOT route MATCHES "^(scalar|vec|matrix|prepass)$")
            message(FATAL_ERROR "${where}: launch_route is scalar, vec, matrix or prepass, got: ${shown}")
        endif()
        set(row_where "${where} ${route}")
        string(TOUPPER "${route}" id)
        if ("${card_cell}" STREQUAL "any")
            set(card "")
        else()
            tsv_card("${card_cell}" "${row_where}" card)
        endif()
        if ("${wave_cell}" STREQUAL "any")
            set(v_wave -1)
        else()
            tsv_number("${wave_cell}" "${row_where}" "wave" 1024 v_wave)
            if (v_wave EQUAL -1)
                message(FATAL_ERROR "${row_where}: wave is any or a number, got -")
            endif()
        endif()
        if (NOT "${card}" STREQUAL "" AND v_wave EQUAL -1)
            message(FATAL_ERROR "${row_where}: a card's row writes the wave the card reports, not any")
        endif()
        if ("${evidence}" STREQUAL "" OR "${evidence}" STREQUAL "-")
            message(FATAL_ERROR "${row_where}: evidence says where the cells come from; it is empty")
        endif()
        set(key "${route}|${card_cell}|${wave_cell}")
        list(FIND seen "${key}" at)
        if (NOT at EQUAL -1)
            message(FATAL_ERROR "${row_where}: two rows for card ${card_cell}, wave ${wave_cell}")
        endif()
        list(APPEND seen "${key}")
        set(is_default 0)
        if ("${card}" STREQUAL "" AND v_wave EQUAL -1)
            set(is_default 1)
            list(APPEND have "${route}")
        else()
            list(FIND have "${route}" at)
            if (at EQUAL -1)
                message(FATAL_ERROR "${row_where}: the route's default row (card any, wave any) comes before its other rows")
            endif()
        endif()
        set(i 3)
        set(written 0)
        foreach(col IN LISTS launch_cols)
            list(GET f ${i} cell)
            tsv_number("${cell}" "${row_where}" "${col}" 65536 v_${col})
            list(FIND reads_${route} "${col}" reads)
            if (v_${col} EQUAL -1)
                if (is_default AND NOT reads EQUAL -1)
                    message(FATAL_ERROR "${row_where}: the default row writes ${col}; it is -")
                endif()
            else()
                set(written 1)
                if (reads EQUAL -1)
                    message(FATAL_ERROR "${row_where}: the route does not read ${col}; write -")
                endif()
                if (NOT is_default AND ("${col}" STREQUAL "workgroups" OR "${col}" STREQUAL "small_queries"))
                    message(FATAL_ERROR "${row_where}: ${col} holds for every card; only the default row writes it")
                endif()
                if (NOT DEFINED bound_${route}_${col})
                    message(FATAL_ERROR "${row_where}: ${col} has no bound in flash-attn/gen-routes.cmake")
                endif()
                tsv_bound("${v_${col}}" "${bound_${route}_${col}}" "${row_where}" "${col}")
            endif()
            math(EXPR i "${i} + 1")
        endforeach()
        if (NOT written)
            message(FATAL_ERROR "${row_where}: the row writes no number")
        endif()
        string(APPEND lrows "    { FA_LAUNCH_${id}, \"${card}\", ${v_wave}, ${v_simdgroups}, ${v_wide_simdgroups}, ${v_wide_head}, ${v_workgroups}, ${v_small_queries}, ${v_threads} },\n")
    endforeach()
    if (first)
        message(FATAL_ERROR "${where}: the section has no header row")
    endif()
    foreach(route scalar vec matrix prepass)
        list(FIND have "${route}" at)
        if (at EQUAL -1)
            message(FATAL_ERROR "${where}: route ${route} has no default row (card any, wave any)")
        endif()
    endforeach()
    set(text "// generated from data/attention.tsv [launch] by flash-attn/gen-routes.cmake; do not edit\n#pragma once\n\n// card \"\" = any; wave -1 = any; a number cell of -1 = the cell is -. The last row is the end mark.\nstatic const struct fa_launch_row fa_launch_rows[] = {\n${lrows}    { -1, 0, 0, 0, 0, 0, 0, 0, 0 },\n};\n")
    if (EXISTS "${OUT_LAUNCH}")
        file(READ "${OUT_LAUNCH}" old)
    else()
        set(old "")
    endif()
    if (NOT old STREQUAL text)
        file(WRITE "${OUT_LAUNCH}" "${text}")
    endif()
endif()
