# Turns routes.tsv into routes-table.h. Run: cmake -DROUTES=... -DOUT=... -P gen-routes.cmake
function(route_cell out name text yes no)
    if (text STREQUAL "any")
        set(${out} -1 PARENT_SCOPE)
    elseif (text STREQUAL "${yes}")
        set(${out} 1 PARENT_SCOPE)
    elseif (text STREQUAL "${no}")
        set(${out} 0 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "routes.tsv: ${name} must be ${yes}, ${no} or any, got '${text}'")
    endif()
endfunction()

file(STRINGS "${ROUTES}" lines)
set(rows "")
set(first 1)
set(want 1)
foreach(line IN LISTS lines)
    if (line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if (first)
        set(first 0)
        continue()
    endif()
    string(REPLACE ";" "," line "${line}")
    string(REPLACE "\t" ";" f "${line}")
    list(LENGTH f n)
    if (NOT n EQUAL 11)
        message(FATAL_ERROR "routes.tsv: expected 11 cells, got ${n}: ${line}")
    endif()
    list(GET f 0 order)
    list(GET f 1 route)
    list(GET f 3 matrix)
    list(GET f 4 vendor)
    list(GET f 5 width)
    list(GET f 6 batch)
    list(GET f 7 kv)
    list(GET f 8 fp8)
    list(GET f 9 head)
    if (NOT order EQUAL want)
        message(FATAL_ERROR "routes.tsv: order must count up from 1, got '${order}' where ${want} was due")
    endif()
    math(EXPR want "${want} + 1")
    if (NOT route MATCHES "^(intel-tiled|scalar|matrix|vec)$")
        message(FATAL_ERROR "routes.tsv: unknown route '${route}'")
    endif()
    string(TOUPPER "${route}" id)
    string(REPLACE "-" "_" id "${id}")
    route_cell(v_matrix "needs_matrix" "${matrix}" yes no)
    route_cell(v_intel "vendor" "${vendor}" intel not-intel)
    route_cell(v_w32 "width" "${width}" 32 not-32)
    route_cell(v_small "batch" "${batch}" small large)
    route_cell(v_same "kv" "${kv}" same differ)
    route_cell(v_fp8 "fp8" "${fp8}" yes no)
    if (head STREQUAL "any")
        set(head 0)
    elseif (NOT head MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "routes.tsv: head must be a number or any, got '${head}'")
    endif()
    string(APPEND rows "    { FA_ROUTE_${id}, ${v_matrix}, ${v_intel}, ${v_w32}, ${v_small}, ${v_same}, ${v_fp8}, ${head} },\n")
endforeach()

set(text "// generated from flash-attn/routes.tsv by flash-attn/gen-routes.cmake; do not edit\n#pragma once\n\nstatic const struct fa_route_row fa_route_rows[] = {\n${rows}};\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
